# Build for variant V3: like Dockerfile, but with a pinned base image (digest)
# and dependencies with hashes (requirements.lock). Renovate keeps the digest up to date.
FROM python:3.14-slim@sha256:f57c4c23b985d95deea5bc5249e2f9c8a512b4cc9d5d3fd31900cbd2f5f0a604

ARG APP_VARIANT=unknown
ARG APP_COMMIT=unknown
ARG APP_BUILD_TIME=unknown

WORKDIR /app

COPY packages/ /packages/
COPY requirements.lock .
RUN pip install --no-cache-dir --disable-pip-version-check --root-user-action ignore --require-hashes -r requirements.lock

COPY app/ .

ENV APP_VARIANT=$APP_VARIANT \
    APP_COMMIT=$APP_COMMIT \
    APP_BUILD_TIME=$APP_BUILD_TIME \
    PYTHONUNBUFFERED=1

USER 10001
EXPOSE 8080
CMD ["python", "main.py"]
